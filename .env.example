# ---------- App ----------
APP_ENV=development
APP_NAME=GCC Intelligence India
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# ---------- Database ----------
DATABASE_URL=sqlite:///./gcc.db

# ---------- Auth ----------
# ACTION REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# ACTION REQUIRED: the email that should become admin when it signs up
ADMIN_EMAIL=

# ---------- AI chat (Groq OpenAI-compatible API) ----------
AI_BASE_URL=https://api.groq.com/openai/v1
# ACTION REQUIRED: paste your Groq API key. Create one at https://console.groq.com/keys
GROQ_API_KEY=
# Groq chat completions endpoint: https://api.groq.com/openai/v1/chat/completions
AI_MODEL=openai/gpt-oss-120b
AI_MAX_TOOL_ROUNDS=4
AI_TEMPERATURE=0
CHAT_RATE_LIMIT_PER_MINUTE=10

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_RETENTION_DAYS=30
